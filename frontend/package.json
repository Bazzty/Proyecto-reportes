  "private": true,
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@testing-library/react-native": "^14.1.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~10.0.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "react-test-renderer": "19.3.0"
  },
  "jest": {
    "preset": "jest-expo",
    "testEnvironment": "./jest.environment.js",
    "testTimeout": 15000,
    "setupFiles": [
      "./jest.setup.js"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.js"
