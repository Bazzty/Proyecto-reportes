# Copia este archivo como .env (no se sube a git). Solo afecta al desarrollo con `npx expo start`;
# el APK toma la URL de eas.json.
#
# Backend LOCAL (Docker en tu PC) — recomendado para desarrollar. Pon la IP local de tu máquina
# (la misma red WiFi que tu celular). En Mac/Linux: ifconfig | grep "inet " · En Windows: ipconfig | findstr IPv4
# Si la IP cambia de red, apiConfig.js la corrige sola con el host de Metro.
EXPO_PUBLIC_API_URL=http://192.168.1.X:8000/api
#
# Backend en AZURE (producción): no edites este archivo, usa `npm run start:azure`.

# API key de Google Maps (Maps SDK for Android). Solo la usa el APK; Expo Go trae su propia key.
# En EAS Build no se lee este archivo: crearla con
#   eas env:create --name GOOGLE_MAPS_API_KEY --environment preview --visibility sensitive
GOOGLE_MAPS_API_KEY=
